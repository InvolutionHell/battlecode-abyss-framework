# Environment of the evaluation platform. Copy to infra/config/lab.env (git-ignored) or point LAB_ENV at your copy.
# lab.py, autosweep.py, arms.py and cmaes_run.py read it on start (variables already set in the environment win); the
# PBS scripts source the file named by LAB_ENV (pass it with qsub -v LAB_ENV=...). Lines are KEY=VALUE, shell syntax:
# quote values with spaces; single quotes keep $VARS for the remote shell. Relative paths are relative to the
# repository root. Every value below is a placeholder or a default - nothing here names a real host or user.

# ---- lab.py: the ssh node pool ----
# Node pool: ssh alias -> slots (copy nodes.example.toml). Hosts, users and keys belong in ~/.ssh/config.
LAB_NODES=infra/config/nodes.toml
# Map sets for `lab.py submit --set` and the sweep spec (falls back to infra/config/mapsets.example.toml).
LAB_MAPSETS=infra/config/mapsets.toml
# Local registry and collected results.
LAB_DATA=data/lab
# The repository checkout on every node; relative = relative to the remote home directory. No spaces.
LAB_REMOTE_ROOT=abyss
# Options for every ssh / rsync to the nodes.
LAB_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=30"
# Repository paths `lab.py push` copies (add "tools" if your post-processing hook uses tools/).
LAB_PUSH="bots infra"
# Prefixed (as `export ...;`) to every remote command, e.g. to put the judge's unswbc version first on PATH.
# LAB_REMOTE_ENV='PATH=$HOME/<venv with the same unswbc version as the judge>/bin:$PATH'
# Optional per-pair hook run on the node after the games (and by infra/pbs/postprocess.pbs):
#   bash -c "$LAB_POSTPROCESS" _ CAND PAIR_DIR RUN_DIR...      (write PAIR_DIR.json to have it collected)
# e.g. the opening KPI table of tools/ per run (add "tools" to LAB_PUSH; text files in the pair folder are collected):
# LAB_POSTPROCESS='for r in "${@:3}"; do PYTHONPATH=tools python3 -m abyss_tools.kpi.opening "$r/replays" > "$r/opening.txt"; done'
# Optional extra report, run as `$LAB_REPORT_CMD TAG DATA_DIR` after `lab.py report TAG`.
# LAB_REPORT_CMD='python3 path/to/kpi_table.py'

# ---- shared ----
# unswbc workspace with the bot folders and maps/ (default <repo>/bots).
# BC_BOTS_DIR=bots
# unswbc executable (default: the one on PATH). Keep it at the judge's version on every machine.
# UNSWBC=unswbc
# Python for the node / job side scripts (default python3).
# LAB_PYTHON=python3

# ---- PBS templates (infra/pbs) ----
# Queue for qsub -q (empty: the site default).
PBS_QUEUE=
# Large outputs of PBS jobs (arena runs, CPU censuses, tuning islands): scratch storage, not a small home quota.
LAB_SCRATCH=/path/to/scratch/battlecode

# ---- tuning backend (infra/tuning, optional) ----
# Root of the island model: islands/, shared-hof/, champion/, islands_active.txt.
EVO_ROOT=/path/to/scratch/battlecode/evo
# Island list (one line per PBS array index).
# ISLANDS=infra/tuning/islands.example.txt
# Python with the `cma` package (and pycapnp for the length-margin term).
# TUNE_PYTHON='uv run -q --with cma --with pycapnp python3'
# keep_islands.sh from another machine: the ssh alias of the PBS submit host and the checkout there.
PBS_SUBMIT_HOST=
PBS_REPO=
